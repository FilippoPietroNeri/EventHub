FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_STORAGE_BUCKET=event-covers
SUPABASE_AUTH_DISABLED=false

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
MAIL_FROM=noreply@eventhub.local
FRONTEND_URL=http://localhost:4200

# Stripe (solo test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_TEST_MODE_ONLY=true
